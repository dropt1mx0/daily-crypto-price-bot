# Telegram bot created with @BotFather.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token


# Target channel numeric ID (often begins with -100) or @public_channel_name.
TELEGRAM_CHANNEL_ID=-1001234567890

# Comma-separated Telegram numeric user IDs allowed to run /update.
TELEGRAM_ADMIN_USER_IDS=123456789

# CoinPaprika works without an API key on its free personal-use tier.
# Optional override; normally leave this unchanged.
# COINPAPRIKA_BASE_URL=https://api.coinpaprika.com/v1

# Europe/Kyiv is also used for scheduled jobs and the image footer.
TIMEZONE=Europe/Kyiv

# Choose daily or interval.
SCHEDULE_MODE=daily
PUBLISH_TIMES=23:05
PUBLISH_INTERVAL_MINUTES=60

# Reject a complete snapshot if any source quote is older than this many seconds.
MAX_QUOTE_AGE_SECONDS=1800

# Optional local font path; defaults to common DejaVu/Liberation/Arial locations.
# FONT_PATH=
